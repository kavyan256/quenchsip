{
  "name": "quench",
  "version": "0.1.0",
  "private": true,
  "description": "Water control room for plastic-free events",
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "test:int": "DDB_ENDPOINT=http://localhost:8000 AUTH_LOCAL_SECRET=test-only DEMO_EMAIL=judge@quench.kavyan.dev node --test itest/",
    "test:e2e": "node --experimental-websocket --no-warnings e2e/flow.mjs",
    "db:start": "docker run -d --rm --name quench-ddb -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -disableTelemetry",
    "db:stop": "docker stop quench-ddb",
    "db:table": "DDB_ENDPOINT=http://localhost:8000 node scripts/create-table.js",
    "api": "DDB_ENDPOINT=http://localhost:8000 node src/local/server.js",
    "scheduler": "DDB_ENDPOINT=http://localhost:8000 node src/local/scheduler.js",
    "sync:web": "mkdir -p web/core web/vendor && cp src/core/*.js web/core/ && cp node_modules/qrcode-generator/dist/qrcode.mjs web/vendor/qrcode.js",
    "serve": "npm run sync:web && python3 -m http.server 8080 -d web",
    "deploy": "sam build && sam deploy",
    "deploy:web": "npm run sync:web && sh scripts/deploy-web.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-sfn": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "qrcode-generator": "^2.0.4"
  }
}
